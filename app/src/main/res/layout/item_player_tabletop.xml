<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/player_container_bg"
    android:clipChildren="true"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/player_container_bg_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:elevation="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.unmatchedcounter.view.LockableRecyclerView
        android:id="@+id/counters_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:elevation="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        Floating extra button anchored to the bottom-end corner. Each tabletop
        panel is rotated by RotateLayout so the player faces inward, which makes
        this corner the one furthest from the table center for every seat.
    -->
    <com.unmatchedcounter.view.ExtraButtonView
        android:id="@+id/extra_button"
        android:layout_width="@dimen/extra_button_size"
        android:layout_height="@dimen/extra_button_size"
        android:layout_margin="@dimen/extra_button_margin"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
